# All optional. The app runs with none of these set.

# Where the SQLite database lives. Default: ./data/seion.db, or /tmp/seion/seion.db on serverless
# hosts (Vercel, Lambda, Netlify), where the project directory is read-only and /tmp is temporary.
DATABASE_PATH=

# Load two demo BOMs (decisions, approvals, RFQs) into a brand-new database: 1 = yes, 0 = no.
# Default: on for temporary (serverless) storage, off otherwise. Settings → "Load demo data" works anytime.
SEION_DEMO_DATA=

# Optional AI fallback for BOM files whose column headers can't be recognised.
# Engineering matching and validation never use AI.
GROQ_API_KEY=
